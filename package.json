{
  "name": "pi-provider-manager-ui",
  "version": "0.2.1",
  "piValidatedVersion": "0.84.2",
  "codexValidatedVersion": "0.149.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wowayou/pi-provider-manager.git"
  },
  "homepage": "https://github.com/wowayou/pi-provider-manager#readme",
  "bugs": {
    "url": "https://github.com/wowayou/pi-provider-manager/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "server": "node server.mjs",
    "check:pi-update": "node scripts/check-pi-update.mjs",
    "test:server": "node --test tests/server.test.mjs tests/model-draft.test.mjs",
    "test:codex": "node --test tests/toml-document.test.mjs tests/litellm-bridge.test.mjs tests/codex-server.test.mjs",
    "test:prompts": "node --test tests/prompt-library.test.mjs",
    "test:codex-real": "node --test tests/codex-real-binary.test.mjs",
    "test:ui": "node --test tests/model-deletion-ui.test.mjs",
    "test:pi-update": "node --test tests/pi-update-monitor.test.mjs",
    "test:release": "node --test tests/release-artifacts.test.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "prepare:release": "node scripts/prepare-release-artifacts.mjs",
    "package:linux": "node scripts/prepare-release-artifacts.mjs && tar -czf artifacts/pi-provider-manager-v${npm_package_version}-linux-wsl.tar.gz -C artifacts pi-provider-manager-v${npm_package_version}",
    "package:release": "npm run build && npm run package:linux",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "6.4.3"
  }
}
