#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
self="$script_dir/$(basename -- "${BASH_SOURCE[0]}")"
bundled_project_dir="$(cd -- "$script_dir/.." && pwd)"

if [[ -n "${PI_PROVIDER_MANAGER_PROJECT_DIR:-}" ]]; then
  project_dir="$PI_PROVIDER_MANAGER_PROJECT_DIR"
elif [[ -f "$PWD/package.json" ]] && grep --quiet '"name"[[:space:]]*:[[:space:]]*"pi-provider-manager-ui"' "$PWD/package.json"; then
  project_dir="$PWD"
elif [[ -f "$bundled_project_dir/package.json" ]] && grep --quiet '"name"[[:space:]]*:[[:space:]]*"pi-provider-manager-ui"' "$bundled_project_dir/package.json"; then
  project_dir="$bundled_project_dir"
else
  project_dir="$HOME/pi-provider-manager-ui"
fi

if [[ -n "${PI_CODING_AGENT_DIR:-}" ]]; then
  agent_dir="$PI_CODING_AGENT_DIR"
  agent_dir_source="PI_CODING_AGENT_DIR"
else
  agent_dir="$HOME/.pi/agent"
  agent_dir_source="default-home"
fi
if [[ -n "${PI_PROVIDER_MANAGER_CODEX_DIR:-}" ]]; then
  codex_dir="$PI_PROVIDER_MANAGER_CODEX_DIR"
  codex_dir_source="PI_PROVIDER_MANAGER_CODEX_DIR"
elif [[ -n "${CODEX_HOME:-}" ]]; then
  codex_dir="$CODEX_HOME"
  codex_dir_source="CODEX_HOME"
else
  codex_dir="$HOME/.codex"
  codex_dir_source="default-home"
fi
# The detached WSL process inherits nothing from this shell, so anything the
# server needs has to be handed over explicitly — including the path to a
# LiteLLM installed in a virtualenv, which is the usual case on Debian and
# Ubuntu where a system-wide pip install is refused.
litellm_bin="${PI_PROVIDER_MANAGER_LITELLM:-}"
node_bin="${PI_PROVIDER_MANAGER_NODE:-}"
if [[ -z "$node_bin" ]]; then
  node_bin="$(command -v node || true)"
fi
open_browser="${PI_PROVIDER_MANAGER_OPEN_BROWSER:-1}"
log_file="$agent_dir/pi-provider-manager-ui.log"

if [[ -z "$node_bin" || ! -x "$node_bin" ]]; then
  echo "Node.js executable not found. Set PI_PROVIDER_MANAGER_NODE explicitly." >&2
  exit 1
fi

if [[ ! -f "$project_dir/package.json" ]]; then
  # Printing the path it settled on and nothing else left the reader guessing
  # which of the four mechanisms above had picked it, and therefore which one to
  # correct. Name all of them, with what each currently resolves to.
  echo "Pi Provider Manager project not found: $project_dir" >&2
  echo "The launcher looks for the checkout in this order:" >&2
  echo "  1. PI_PROVIDER_MANAGER_PROJECT_DIR  (${PI_PROVIDER_MANAGER_PROJECT_DIR:-unset})" >&2
  echo "  2. the current directory            ($PWD)" >&2
  echo "  3. the directory above this script  ($bundled_project_dir)" >&2
  echo "  4. \$HOME/pi-provider-manager-ui     ($HOME/pi-provider-manager-ui)" >&2
  echo "Run it once against your checkout:" >&2
  echo "  PI_PROVIDER_MANAGER_PROJECT_DIR=/path/to/checkout '$0'" >&2
  echo "Or install a launcher that remembers the path, from inside the checkout:" >&2
  echo "  npm run install:launcher" >&2
  exit 1
fi

# The floor is declared once, in package.json's engines field, and read from
# there. Repeating the number here would create a second copy to keep in step,
# and a launcher that disagreed with the manifest is worse than no check: the
# failure it replaces is an obscure syntax error from inside the server.
# The floor is the lowest major any alternative in the range allows, so a
# manifest written as "^20 || ^18" is not read as requiring 20. ES5 only: this
# has to run on the old Node it exists to reject.
node_floor="$("$node_bin" -e '
  var fs = require("fs");
  try {
    var engines = JSON.parse(fs.readFileSync(process.argv[1], "utf8")).engines || {};
    var majors = [];
    (engines.node || "").split("||").forEach(function (alternative) {
      var found = /([0-9]+)/.exec(alternative);
      if (found) { majors.push(Number(found[1])); }
    });
    process.stdout.write(majors.length ? String(Math.min.apply(null, majors)) : "");
  } catch (error) {}
' "$project_dir/package.json" 2>/dev/null || true)"
node_major="$("$node_bin" -e 'process.stdout.write(String(process.versions.node.split(".")[0]))' 2>/dev/null || true)"
if [[ -n "$node_floor" && "$node_major" =~ ^[0-9]+$ ]] && (( node_major < node_floor )); then
  echo "Node.js $node_major is too old: this project needs $node_floor or newer." >&2
  echo "  using: $node_bin" >&2
  echo "Upgrade Node, or point PI_PROVIDER_MANAGER_NODE at a newer one." >&2
  exit 1
fi

# A copy of this launcher installed elsewhere goes stale the moment the checkout
# moves ahead of it, and a stale copy does not fail — it starts, and silently
# stops handing the Codex directory and the LiteLLM path to the detached server,
# so the managed bridge breaks with nothing on screen connecting it to the cause.
# Content is compared rather than a version string, so there is no second copy of
# the version to maintain, and it catches a copy from any generation.
project_launcher="$project_dir/bin/pi-provider-manager-ui"
if [[ -f "$self" && -f "$project_launcher" ]] && ! [[ "$self" -ef "$project_launcher" ]] &&
  [[ "$(cat -- "$self" 2>/dev/null)" != "$(cat -- "$project_launcher" 2>/dev/null)" ]]; then
  echo "Warning: the launcher you ran is not the one in the checkout it is about to start." >&2
  echo "  running:  $self" >&2
  echo "  checkout: $project_launcher" >&2
  echo "  An older copy still starts, but stops handing over the Codex directory and the" >&2
  echo "  LiteLLM path, which breaks the managed bridge. Replace it with a shim that" >&2
  echo "  cannot go stale:" >&2
  echo "    (cd '$project_dir' && npm run install:launcher)" >&2
fi

if [[ ! -f "$project_dir/dist/client/index.html" ]]; then
  echo "Built UI not found. Run 'npm ci && npm run build' in: $project_dir" >&2
  exit 1
fi

is_manager_port() {
  curl --silent --fail --max-time 1 "http://127.0.0.1:$1/api/state" 2>/dev/null |
    grep --quiet '"configMode":"preserve-unknown-fields"'
}

# Asks Node whether the port can be bound rather than whether it can be
# connected to. bash's /dev/tcp has no connect timeout, and under WSL2 mirrored
# networking a connect to an unbound loopback port is neither accepted nor
# refused — it simply never returns, and the launcher hangs with nothing on
# screen. Binding is also the more accurate question: the server binds
# 127.0.0.1, so this tests exactly what it will do.
port_in_use() {
  "$node_bin" -e '
    const net = require("node:net");
    const server = net.createServer();
    server.once("error", () => process.exit(0));
    server.listen(Number(process.argv[1]), "127.0.0.1", () => server.close(() => process.exit(1)));
  ' "$1" >/dev/null 2>&1
}

if [[ -n "${PI_PROVIDER_MANAGER_PORT:-}" ]]; then
  port="$PI_PROVIDER_MANAGER_PORT"
  if [[ ! "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
    echo "PI_PROVIDER_MANAGER_PORT must be an integer between 1 and 65535." >&2
    exit 1
  fi
  if port_in_use "$port" && ! is_manager_port "$port"; then
    echo "Port $port is already used by another application. Choose a different PI_PROVIDER_MANAGER_PORT." >&2
    exit 1
  fi
else
  port=""
  for candidate in $(seq 43127 43146); do
    if port_in_use "$candidate" && is_manager_port "$candidate"; then
      port="$candidate"
      break
    fi
  done
  if [[ -z "$port" ]]; then
    for candidate in $(seq 43127 43146); do
      if ! port_in_use "$candidate"; then
        port="$candidate"
        break
      fi
    done
  fi
  if [[ -z "$port" ]]; then
    echo "No free port found in 43127-43146. Set PI_PROVIDER_MANAGER_PORT explicitly." >&2
    exit 1
  fi
fi

url="http://127.0.0.1:${port}/"

# Reusing an already-running manager is the point of the port scan, but saying
# nothing about it made "restart it" an instruction nobody could carry out: the
# launcher printed the same lines either way, so a manager still running with a
# stale view of the machine looked freshly started.
reused=0
if is_manager_port "$port"; then reused=1; fi

if [[ "$reused" -eq 0 ]]; then
  if [[ -n "${WSL_DISTRO_NAME:-}" ]] && command -v powershell.exe >/dev/null 2>&1; then
    escaped_project_dir=${project_dir//\'/\'\'}
    escaped_agent_dir=${agent_dir//\'/\'\'}
    escaped_codex_dir=${codex_dir//\'/\'\'}
    escaped_litellm_bin=${litellm_bin//\'/\'\'}
    escaped_node_bin=${node_bin//\'/\'\'}
    powershell.exe -NoProfile -Command \
      "\$arguments = @('-d', '${WSL_DISTRO_NAME}', '--', 'env', 'PI_PROVIDER_MANAGER_PORT=${port}', 'PI_PROVIDER_MANAGER_SERVE_UI=1', 'PI_PROVIDER_MANAGER_AGENT_DIR_SOURCE=${agent_dir_source}', 'PI_CODING_AGENT_DIR=${escaped_agent_dir}', 'PI_PROVIDER_MANAGER_CODEX_DIR=${escaped_codex_dir}', 'PI_PROVIDER_MANAGER_CODEX_DIR_SOURCE=${codex_dir_source}', 'PI_PROVIDER_MANAGER_LITELLM=${escaped_litellm_bin}', '${escaped_node_bin}', '${escaped_project_dir}/server.mjs'); Start-Process -FilePath 'wsl.exe' -ArgumentList \$arguments -WindowStyle Hidden" \
      >/dev/null 2>&1
  else
    nohup env PI_PROVIDER_MANAGER_PORT="$port" PI_PROVIDER_MANAGER_SERVE_UI=1 PI_PROVIDER_MANAGER_AGENT_DIR_SOURCE="$agent_dir_source" PI_CODING_AGENT_DIR="$agent_dir" \
      PI_PROVIDER_MANAGER_CODEX_DIR="$codex_dir" PI_PROVIDER_MANAGER_CODEX_DIR_SOURCE="$codex_dir_source" \
      PI_PROVIDER_MANAGER_LITELLM="$litellm_bin" \
      "$node_bin" "$project_dir/server.mjs" \
      >"$log_file" 2>&1 </dev/null &
  fi

  ready=0
  for _ in $(seq 1 40); do
    if is_manager_port "$port"; then
      ready=1
      break
    fi
    sleep 0.25
  done

  if [[ "$ready" -ne 1 ]]; then
    echo "Pi Provider Manager failed to start." >&2
    echo "Run manually: PI_PROVIDER_MANAGER_PORT='$port' PI_PROVIDER_MANAGER_SERVE_UI=1 PI_CODING_AGENT_DIR='$agent_dir' PI_PROVIDER_MANAGER_CODEX_DIR='$codex_dir' '$node_bin' '$project_dir/server.mjs'" >&2
    exit 1
  fi
fi

# Always say where it is listening, and which directories it will edit. Printing
# this only when the browser is not opened left anyone whose browser bridge
# misbehaved with no port and no error; naming the directories makes an
# unset-variable mistake — CODEX_HOME="" silently means the real one — visible
# before anything is saved.
echo "Pi Provider Manager is ready: $url"
if [[ "$reused" -eq 1 ]]; then
  # A reused server is using whatever it was started with, which need not match
  # this shell. Report what it says about itself rather than what we computed,
  # or the directory lines would be a confident guess.
  running="$(curl --silent --fail --max-time 2 "http://127.0.0.1:$port/api/state" 2>/dev/null |
    "$node_bin" -e '
      let s = "";
      process.stdin.on("data", (c) => { s += c; }).on("end", () => {
        try {
          const state = JSON.parse(s);
          process.stdout.write([
            state.compatibility?.appVersion || "",
            state.agentDir || "",
            state.codex?.dir || "",
            state.compatibility?.servicePid || "",
          ].join("\n"));
        } catch {}
      });
    ' 2>/dev/null || true)"
  running_version="$(printf '%s' "$running" | sed -n 1p)"
  running_pid="$(printf '%s' "$running" | sed -n 4p)"
  # An instance older than 0.3.0 does not report its process id. Ask the kernel
  # who holds the port instead — anything else is a guess, and the guess this
  # used to print named *this* launcher's directory, which is exactly the
  # directory the running instance is not in during an upgrade.
  if [[ -z "$running_pid" ]] && command -v ss >/dev/null 2>&1; then
    running_pid="$(ss -ltnpH "sport = :$port" 2>/dev/null | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2)"
  fi
  echo "  (reused the instance already running on this port${running_version:+, version $running_version})"
  echo "  Pi config:    $(printf '%s' "$running" | sed -n 2p)"
  echo "  Codex config: $(printf '%s' "$running" | sed -n 3p)"
  echo "  Restart it to pick up an upgrade or a newly installed LiteLLM:"
  if [[ -n "$running_pid" ]]; then
    echo "    kill $running_pid && '$0'"
  else
    echo "    Could not determine its process id. Find it with: pgrep -af server.mjs"
  fi
else
  echo "  Pi config:    $agent_dir"
  echo "  Codex config: $codex_dir"
fi
# Only worth a line when it is set: an empty value means "find litellm on PATH".
if [[ -n "$litellm_bin" ]]; then echo "  LiteLLM:      $litellm_bin"; fi

# The browser bridge is best-effort and must never hold the terminal: wslview and
# powershell.exe can both block, and when they do the launcher looks hung with
# nothing on screen. Detach it and move on.
if [[ "$open_browser" != "0" ]]; then
  if command -v wslview >/dev/null 2>&1; then
    ( nohup wslview "$url" >/dev/null 2>&1 </dev/null & ) >/dev/null 2>&1
  elif command -v powershell.exe >/dev/null 2>&1; then
    ( nohup powershell.exe -NoProfile -Command "Start-Process '$url'" >/dev/null 2>&1 </dev/null & ) >/dev/null 2>&1
  fi
fi
